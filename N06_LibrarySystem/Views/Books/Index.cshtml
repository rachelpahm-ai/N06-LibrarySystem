@model IEnumerable<N06_LibrarySystem.Models.Book>
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thư Viện Điện Tử - BookNest</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 flex flex-col min-h-screen">

    <header class="bg-[#3b438b] text-white shadow-md">
        <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="bg-orange-500 text-white p-2.5 rounded-lg flex items-center justify-center font-bold shadow">
                    <i class="fa-solid fa-book-open text-xl"></i>
                </div>
                <div>
                    <h1 class="text-[10px] uppercase tracking-wider font-semibold text-slate-200">SỞ GIÁO DỤC VÀ ĐÀO TẠO HUFLIT</h1>
                    <h2 class="text-sm md:text-base font-bold tracking-tight text-white">KHO HỌC LIỆU ĐIỆN TỬ - BOOKNEST</h2>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <a href="#" class="border border-slate-300/40 hover:bg-white/10 text-white text-xs px-3 py-1.5 rounded transition">
                    Thể loại
                </a>
            </div>
        </div>
    </header>

    <div class="max-w-7xl mx-auto px-4 py-6 flex-1 w-full flex flex-col md:flex-row gap-6">

        <aside class="w-full md:w-64 flex-shrink-0 space-y-4">
            <div class="bg-white rounded-md shadow-sm border border-slate-200 overflow-hidden">
                <div class="bg-[#2d3472] text-white px-4 py-3 font-bold text-xs uppercase flex items-center gap-2 tracking-wider">
                    <i class="fa-solid fa-list"></i> THƯ MỤC SÁCH
                </div>
                <ul class="divide-y divide-slate-100 text-xs font-medium text-slate-700">
                    <li>
                        <a href="#" class="flex items-center justify-between px-4 py-3 hover:bg-slate-50 hover:text-indigo-600 transition">
                            <span class="flex items-center gap-2.5 text-slate-700"><i class="fa-solid fa-book text-slate-400 text-sm"></i> Thể loại</span>
                            <i class="fa-solid fa-chevron-right text-[10px] text-slate-400"></i>
                        </a>
                    </li>
                    <li>
                        <a href="#" class="flex items-center justify-between px-4 py-3 hover:bg-slate-50 hover:text-indigo-600 transition">
                            <span class="flex items-center gap-2.5 text-slate-700"><i class="fa-solid fa-headphones text-slate-400 text-sm"></i> Tìm kiếm</span>
                            <i class="fa-solid fa-chevron-right text-[10px] text-slate-400"></i>
                        </a>
                    </li>
                    <li>
                        <a href="#" class="flex items-center justify-between px-4 py-3 hover:bg-slate-50 hover:text-indigo-600 transition">
                            <span class="flex items-center gap-2.5 text-slate-700"><i class="fa-solid fa-image text-slate-400 text-sm"></i> Mượn Sách</span>
                            <i class="fa-solid fa-chevron-right text-[10px] text-slate-400"></i>
                        </a>
                    </li>
                    <li>
                        <a href="#" class="flex items-center justify-between px-4 py-3 hover:bg-slate-50 hover:text-indigo-600 transition">
                            <span class="flex items-center gap-2.5 text-slate-700"><i class="fa-solid fa-video text-slate-400 text-sm"></i> Đặt trước</span>
                            <i class="fa-solid fa-chevron-right text-[10px] text-slate-400"></i>
                        </a>
                    </li>
                </ul>
            </div>
        </aside>

        <main class="flex-1 space-y-6">

            <div class="relative bg-gradient-to-r from-blue-50 via-indigo-50 to-blue-100 border border-slate-200/80 rounded-xl p-6 md:p-8 shadow-sm overflow-hidden flex flex-col md:flex-row items-center justify-between gap-6">
                <div class="space-y-3 text-center md:text-left z-10 max-w-lg">
                    <div class="inline-block bg-[#3b438b] text-white text-[10px] font-bold uppercase px-3 py-1 rounded-full tracking-wider shadow-sm">
                        Sự kiện đặc biệt
                    </div>
                    <h2 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight">WORLD BOOK DAY</h2>
                    <p class="text-xs md:text-sm text-slate-600 leading-relaxed">
                        Khám phá kho tàng kiến thức tri thức với hàng ngàn đầu sách công nghệ, kỹ năng sống và văn học chất lượng cao.
                    </p>
                </div>

                <div class="flex items-center gap-3 z-10">
                    <div class="w-24 sm:w-28 bg-[#1e2348] text-white p-3 rounded-lg shadow-lg border-2 border-slate-700 text-center transform -rotate-3 hover:rotate-0 transition">
                        <span class="block text-[10px] font-extrabold text-amber-400 uppercase tracking-widest mb-1">Clean Code</span>
                        <div class="bg-[#151934] py-2 px-1 rounded text-[10px] font-bold text-slate-200 tracking-tighter">450.000 đ</div>
                    </div>
                    <div class="w-24 sm:w-28 bg-[#8b2626] text-white p-3 rounded-lg shadow-lg border-2 border-red-700 text-center transform rotate-3 hover:rotate-0 transition">
                        <span class="block text-[10px] font-extrabold text-amber-300 uppercase tracking-widest mb-1">Đắc Nhân Tâm</span>
                        <div class="bg-[#6b1c1c] py-2 px-1 rounded text-[10px] font-bold text-slate-100 tracking-tighter">98.000 đ</div>
                    </div>
                </div>
            </div>

            <div class="bg-white p-5 rounded-md shadow-sm border border-slate-200">
                <div class="flex items-center gap-6 border-b border-slate-200 text-xs md:text-sm font-semibold text-slate-500 pb-3">
                    <button class="text-indigo-600 border-b-2 border-indigo-600 pb-3 -mb-3">Mới cập nhật</button>
                    <button class="hover:text-slate-800 transition">Nổi bật</button>
                    <button class="hover:text-slate-800 transition">Xem nhiều nhất</button>
                </div>

                <div class="flex items-center justify-between mt-6">
                    <div class="flex items-center gap-2">
                        <div class="w-1.5 h-5 bg-[#3b438b] rounded-full"></div>
                        <h3 class="text-base md:text-lg font-bold text-slate-800">Sách điện tử</h3>
                    </div>
                    <a href="@Url.Action("Create", "Books")" class="bg-[#2d3472] hover:bg-indigo-900 text-white text-xs px-3.5 py-2 rounded transition shadow-sm font-medium">
                        + Thêm Sách Mới
                    </a>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 mt-4">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <div class="bg-white border border-slate-200 rounded-lg overflow-hidden shadow-sm hover:shadow-md transition flex flex-col justify-between group">
                                <div class="relative bg-slate-100 aspect-[3/4] flex items-center justify-center overflow-hidden">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Title" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
                                    }
                                    else
                                    {
                                        <div class="absolute inset-0 bg-[#1e2348] flex flex-col items-center justify-center p-3 text-center">
                                            <span class="text-xs md:text-sm font-black text-white tracking-wider uppercase">@item.Title</span>
                                        </div>
                                    }
                                </div>
                                <div class="p-2.5 flex flex-col justify-between flex-1 bg-slate-50">
                                    <div>
                                        <h4 class="font-bold text-xs text-slate-800 truncate" title="@item.Title">@item.Title</h4>
                                        <p class="text-[10px] text-slate-500 truncate mt-0.5">Tác giả</p>
                                    </div>
                                    <div class="mt-2 pt-2 border-t border-slate-200 flex items-center justify-between text-[11px]">
                                        <span class="font-bold text-emerald-700">@string.Format("{0:N0} đ", item.Price)</span>
                                        <span class="text-slate-400 font-medium text-[10px]">Kho: @item.StockQuantity</span>
                                    </div>

                                    <!-- CHỈ HIỂN THỊ NÚT SỬA VÀ XÓA KHI ĐÂY LÀ SÁCH MỚI THÊM (BookID > 8) -->
                                    @if (item.BookID > 8)
                                    {
                                        <div class="mt-2 pt-2 border-t border-slate-100 flex items-center justify-between text-[11px]">
                                            <a href="@Url.Action("Edit", "Books", new { id = item.BookID })" class="text-blue-600 hover:text-blue-800 font-bold flex items-center gap-1">
                                                <i class="fa-solid fa-pen-to-square"></i> Sửa
                                            </a>
                                            <a href="@Url.Action("Delete", "Books", new { id = item.BookID })" class="text-red-500 hover:text-red-700 font-bold flex items-center gap-1" onclick="return confirm('Bạn có chắc muốn xóa sách này không?');">
                                                <i class="fa-solid fa-trash"></i> Xóa
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-xs text-slate-500 col-span-full py-4 text-center">Chưa có dữ liệu sách trong cơ sở dữ liệu.</p>
                    }
                </div>
            </div>

            <div class="bg-white p-5 rounded-md shadow-sm border border-slate-200">
                <div class="flex items-center gap-2 mb-4">
                    <div class="w-1.5 h-5 bg-[#3b438b] rounded-full"></div>
                    <h3 class="text-base md:text-lg font-bold text-slate-800">CHỦ ĐỀ PHỔ BIẾN (SUBJECTS)</h3>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="p-4 border border-slate-200 rounded-lg flex items-center justify-between bg-slate-50 hover:shadow transition">
                        <div>
                            <h4 class="font-bold text-sm text-slate-800">Science</h4>
                            <p class="text-xs text-slate-500 mt-0.5">1.2k Sách sẵn có</p>
                        </div>
                        <i class="fa-solid fa-flask text-slate-400 text-xl"></i>
                    </div>
                    <div class="p-4 border border-slate-200 rounded-lg flex items-center justify-between bg-slate-50 hover:shadow transition">
                        <div>
                            <h4 class="font-bold text-sm text-slate-800">Arts</h4>
                            <p class="text-xs text-slate-500 mt-0.5">1.8k Sách sẵn có</p>
                        </div>
                        <i class="fa-solid fa-palette text-slate-400 text-xl"></i>
                    </div>
                    <div class="p-4 border border-slate-200 rounded-lg flex items-center justify-between bg-slate-50 hover:shadow transition">
                        <div>
                            <h4 class="font-bold text-sm text-slate-800">Commerce</h4>
                            <p class="text-xs text-slate-500 mt-0.5">230 Sách sẵn có</p>
                        </div>
                        <i class="fa-solid fa-chart-line text-slate-400 text-xl"></i>
                    </div>
                </div>
            </div>

        </main>
    </div>

    <footer class="bg-[#2d3472] text-slate-300 text-xs mt-auto border-t border-indigo-900">
        <div class="max-w-7xl mx-auto px-4 py-6 flex justify-between items-center">
            <span class="font-bold text-white text-sm">BookNest</span>
            <div class="text-[11px] text-slate-400">
                &copy; 2026 BookNest. All rights reserved.
            </div>
        </div>
    </footer>
</body>
</html>