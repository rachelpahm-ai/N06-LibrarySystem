@model N06_LibrarySystem.Models.Book
@{
    ViewBag.Title = "Thêm Mới Sách - BookNest";
}
<header class="bg-[#3b438b] text-white shadow-md">
    <div class="max-w-7xl mx-auto px-4 py-3 flex items-center gap-3">
        <div class="bg-orange-500 text-white p-2 rounded flex items-center justify-center font-bold">
            <i class="fa-solid fa-book-open text-xl"></i>
        </div>
        <div>
            <h1 class="text-xs uppercase tracking-wider font-semibold text-slate-200">SỞ GIÁO DỤC VÀ ĐÀO TẠO HOÀNG GIA</h1>
            <h2 class="text-base font-bold tracking-tight text-white">KHO HỌC LIỆU ĐIỆN TỬ - BOOKNEST</h2>
        </div>
    </div>
</header>

<div class="max-w-3xl mx-auto bg-white p-6 rounded-xl shadow-md border border-slate-200 mt-8 mb-8">
    <div class="flex items-center justify-between border-b border-slate-100 pb-4 mb-5">
        <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
            <span class="text-indigo-600 text-lg">+</span> THÊM MỚI SÁCH VÀO THƯ VIỆN
        </h2>
        <a href="@Url.Action("Index", "Books")" class="text-xs font-semibold text-indigo-600 hover:text-indigo-800 hover:underline flex items-center gap-1 transition">
            ← Quay lại
        </a>
    </div>

    @using (Html.BeginForm("Create", "Books", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(false, "", new { @class = "text-xs text-red-600 bg-red-50 p-3 rounded-lg border border-red-200 mb-4" })

        <div class="space-y-4">
            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Tên Sách <span class="text-red-500">*</span></label>
                <input type="text" name="Title" required placeholder="Nhập tên sách..." class="w-full px-3.5 py-2.5 text-xs border border-slate-300 rounded-lg outline-none focus:border-indigo-600 focus:ring-1 focus:ring-indigo-600 transition" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Tên Tác Giả <span class="text-red-500">*</span></label>
                <input type="text" name="AuthorName" required placeholder="Nhập tên tác giả..." class="w-full px-3.5 py-2.5 text-xs border border-slate-300 rounded-lg outline-none focus:border-indigo-600 focus:ring-1 focus:ring-indigo-600 transition" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Giá Tiền (VNĐ) <span class="text-red-500">*</span></label>
                    <input type="number" name="Price" required placeholder="Ví dụ: 150000" class="w-full px-3.5 py-2.5 text-xs border border-slate-300 rounded-lg outline-none focus:border-indigo-600 focus:ring-1 focus:ring-indigo-600 transition" />
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Số Lượng Kho <span class="text-red-500">*</span></label>
                    <input type="number" name="StockQuantity" required placeholder="Ví dụ: 10" class="w-full px-3.5 py-2.5 text-xs border border-slate-300 rounded-lg outline-none focus:border-indigo-600 focus:ring-1 focus:ring-indigo-600 transition" />
                </div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Ảnh Bìa Sách</label>
                <input type="file" name="imageFile" class="w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-[#2d3472] file:text-white hover:file:bg-indigo-900 transition cursor-pointer" />
            </div>

            <div class="flex items-center justify-end gap-2 pt-4 border-t border-slate-100">
                <a href="@Url.Action("Index", "Books")" class="px-4 py-2 bg-slate-200 text-slate-700 text-xs font-bold rounded-lg hover:bg-slate-300 transition">
                    Hủy
                </a>
                <button type="submit" class="px-5 py-2 bg-[#2d3472] text-white text-xs font-bold rounded-lg hover:bg-indigo-900 transition shadow-sm">
                    Lưu Lại
                </button>
            </div>
        </div>
    }
</div>